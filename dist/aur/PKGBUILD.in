# Template for the AUR package; bin/release fills in the version and checksum.
# Set _owner to the GitHub account the project is published under.
_owner=CHANGE_ME
pkgname=deadzone
pkgver=0
pkgrel=1
pkgdesc='Controller deadzones, response curves, overlay, and practice tools for Rocket League'
arch=('x86_64' 'aarch64')
url="https://github.com/$_owner/deadzone"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'polkit' 'acl')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/deadzone "$pkgdir/usr/bin/deadzone"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/deadzone.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/deadzone.svg"
  install -Dm644 pkgbuild/deadzone.desktop "$pkgdir/usr/share/applications/deadzone.desktop"
  install -Dm644 pkgbuild/deadzone.service "$pkgdir/usr/lib/systemd/user/deadzone.service"
}
