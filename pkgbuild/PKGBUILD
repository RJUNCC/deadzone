pkgname=deadzone
pkgver=0.10.1
pkgrel=1
pkgdesc='Stick deadzones, response curves, and trigger ranges for any controller'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'polkit' 'acl')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/deadzone "$pkgdir/usr/bin/deadzone"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/deadzone.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/deadzone.svg"
  install -Dm644 "$startdir/deadzone.desktop" "$pkgdir/usr/share/applications/deadzone.desktop"
  install -Dm644 "$startdir/deadzone.service" "$pkgdir/usr/lib/systemd/user/deadzone.service"
}
